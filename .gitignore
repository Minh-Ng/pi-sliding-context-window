# Installed dependencies. In the former monorepo this was ignored at the
# repository root; the standalone repo must ignore it here.
node_modules/

# Never commit registry credentials.
.npmrc

# Local evaluation and benchmark output can contain machine metadata or
# content-shaped fixture fields. Formal release captures belong outside the repo.
artifacts/

# The standalone daemon's checkout-relative default is local runtime state.
.context-window/

# Compiled-module bytecode cache written by the daemon at runtime.
.compile-cache/
